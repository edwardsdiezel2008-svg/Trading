# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit it, and never commit a keypair file.

# RPC endpoint. Use a devnet URL first, switch to mainnet-beta only when you
# mean to spend real money. Public mainnet RPCs are rate-limited; get a free
# key from Helius/QuickNode/Triton for anything beyond testing.
RPC_URL=https://api.devnet.solana.com

# Path to a Solana CLI keypair JSON file (the array-of-numbers format
# produced by `solana-keygen new`). This wallet pays for and controls
# everything the scripts do. Fund it yourself; the scripts never generate
# or transfer funds into it.
WALLET_KEYPAIR_PATH=./wallet.json

# Token parameters - see config/tokenomics.example.json for the full set
# with comments. These four are read directly by create-token.js.
TOKEN_NAME=Example Memecoin
TOKEN_SYMBOL=EXMC
TOKEN_DECIMALS=6
TOKEN_SUPPLY=1000000000

# Filled in automatically by earlier steps - upload-metadata.js writes
# METADATA_URI, create-token.js writes TOKEN_MINT. Leave blank initially.
METADATA_URI=
TOKEN_MINT=
