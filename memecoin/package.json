{
  "name": "memecoin-launch",
  "version": "0.1.0",
  "private": true,
  "description": "Scripted, auditable pipeline for launching an SPL memecoin on Solana. You hold the wallet and the funds; these scripts only prepare and submit transactions you already control.",
  "type": "module",
  "scripts": {
    "create-token": "node scripts/create-token.js",
    "upload-metadata": "node scripts/upload-metadata.js",
    "attach-metadata": "node scripts/attach-metadata.js",
    "revoke-authorities": "node scripts/revoke-authorities.js",
    "verify": "node scripts/verify-token.js"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "@solana/spl-token": "0.4.15",
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "@metaplex-foundation/umi": "1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "1.5.1",
    "dotenv": "16.4.5"
  }
}
